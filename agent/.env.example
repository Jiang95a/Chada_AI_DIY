# ============================================================================
# ⚠️ 这是**模板**，不是你要用的配置。真实配置在 .env（已被 .gitignore 忽略）。
#
#    第一次安装：copy .env.example .env   然后填 key
#    之后每次启动：**不要再执行上面那行** —— 它会把 .env 覆盖成这份空模板，
#                  你填的 key 会全部消失（这个坑已经踩过一次了）。
#
#    start.ps1 现在会先自检 .env，缺 key 会直接告诉你缺哪几行，不会闷头启动。
#
#    ⚠️ 也**不要**把真实 key 写进这个文件：它被 git 跟踪，会直接推到 GitHub。
# ============================================================================

# 模型（必填）
LLM_PROVIDER=deepseek
LLM_API_KEY=

# 以下留空则使用 app/core/config.py 里 PROVIDER_PRESETS 的默认值
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# 服务
HOST=127.0.0.1
PORT=8000
# 上线必须改成具体域名；填 * 时代码会自动关掉 allow_credentials（浏览器不接受通配符带凭证）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 记忆
HISTORY_LIMIT=20

# ---------------------------------------------------------------
# 视觉 / 多模态：海报解析。必须是一个能读图的模型。
# 主模型可以就用 deepseek（便宜、擅长写方案），海报解析单独配一套。
# 三个值都不填 = 没配视觉模型，/poster/extract 会老实返回 503，前端回退手动填写。
# ---------------------------------------------------------------
VISION_MODEL=
# 留空则复用 LLM_API_KEY
VISION_API_KEY=
# 留空则复用 LLM_BASE_URL
VISION_BASE_URL=
VISION_ENABLED=true
VISION_TIMEOUT=90
# 和前端上传限制保持一致（字节）
POSTER_MAX_BYTES=5242880

# ---------------------------------------------------------------
# 图像生成：/ai/poster/generate 的「AI 海报底图」。
# 走 OpenAI 兼容的 POST {base}/images/generations，必须是**支持出图**的供应商：
# 阿里百炼（wanx）、智谱（cogview）、OpenAI（dall-e-3）。
# deepseek 只有文本和视觉，**没有图像生成接口**，别把它的 key 填到这里。
# IMAGE_MODEL 留空 = 不生成海报，接口返回 503，前端提示「改用上传已有海报」——
# 这是设计好的降级，不是 bug。
# ---------------------------------------------------------------
IMAGE_ENABLED=true
# 例：wanx-v1 / cogview-3 / dall-e-3
IMAGE_MODEL=
# 留空会回退到 LLM_API_KEY——那边是 deepseek 的 key，请求百炼会 401，所以这里必须单独填
IMAGE_API_KEY=
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_BASE_URL=
# 出图很慢，比 VISION_TIMEOUT 还宽
IMAGE_TIMEOUT=150
IMAGE_SIZE=1024x1024

# ---------------------------------------------------------------
# RAG：本地知识库检索（data/knowledge/*.md）
# 默认 local = 本地哈希向量，零依赖、离线可跑、可复现；
# 想用真 embedding 就改 api，并保证 LLM_API_KEY 能调 embeddings 接口。
# ---------------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=4
# 低于这个「内容分」的资料直接丢掉，不喂给模型
RAG_MIN_SCORE=0.20
RAG_CONTEXT_CHARS=1800
EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512

# ---------------------------------------------------------------
# AI 安全护栏
# ---------------------------------------------------------------
GUARD_ENABLED=true
# 单 IP 每分钟最多几次花钱的调用（/chat、/poster/extract）
RATE_LIMIT_PER_MINUTE=40
# 客户端可控的「本次附加要求」最大长度，超了截断。
# 别往下调：后端 AiService.PLAN_SYSTEM_EXTRA 有 435 字（含 13 个受控组件的白名单），
# 卡到 300 会把尾巴上的白名单整段截掉，模型就收不到组件清单了。
SYSTEM_EXTRA_MAX_CHARS=1000

# ---------------------------------------------------------------
# 危机关怀（心理社团场景必需，别关）
# 识别到自伤 / 自杀表达时，智能体会**停止生成**，直接返回下面的求助资源。
# ⚠️ 上线前必须换成你校的真实信息：每个学校的心理中心地点、预约方式、
#    当地热线都不一样。写死一个"学活 305"是最容易被评委问穿的地方。
# ---------------------------------------------------------------
CRISIS_GUARD_ENABLED=true
CRISIS_HOTLINE_NAME=全国心理援助热线
# 换成你所在省市确认过的号码
CRISIS_HOTLINE=12356
CRISIS_EMERGENCY=110 / 120
# 这一行会原样出现在回复和生成的页面里，写成学生看得懂的话
CRISIS_CENTER_HINT=学校心理健康教育中心（工作日可预约）

# ---------------------------------------------------------------
# 数据库：sqlite（默认，零依赖）或 mysql（联调/部署）
# 开发期建议保持 sqlite，跑得快；联调时改成 mysql 再重启即可
# ---------------------------------------------------------------
DB_BACKEND=sqlite

# sqlite 专用
DB_PATH=data/agent.db

# mysql 专用（DB_BACKEND=mysql 时才读；库不存在会自动创建）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_agent
